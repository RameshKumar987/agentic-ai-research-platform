# --- ResearchHub backend ---
# All values are optional. The app runs without any API key.

APP_NAME="ResearchHub API"

# Comma-separated allowed frontend origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Maximum projects kept in memory before the oldest is evicted
MAX_PROJECTS=200

# --- Optional LLM summary adapter ---
# Keep "template" for the deterministic, key-free demo.
LLM_PROVIDER=template

# Only used when LLM_PROVIDER=gemini. Never put this value in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend (optional) ---
# Leave empty in development to use the Vite /api proxy.
# VITE_API_URL=http://127.0.0.1:8000
